# Set APP_ENV=production only in a managed HTTPS environment.
APP_ENV=development
DATABASE_URL=
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
APP_ALLOWED_HOSTS=

# Docker Compose database settings. Supply real values outside version control.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Keep external AI providers disabled unless explicitly configured.
AI_CHAT_PROVIDER=disabled
AI_RAG_ENABLED=false
