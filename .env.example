# Set APP_ENV=production only in a managed HTTPS environment.
APP_ENV=development
DATABASE_URL=
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
APP_ALLOWED_HOSTS=
FORWARDED_ALLOW_IPS=127.0.0.1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Docker Compose database settings. Supply real values outside version control.
POSTGRES_DB=nava
POSTGRES_USER=nava
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Keep external AI providers disabled unless explicitly configured.
AI_CHAT_PROVIDER=disabled
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_CHAT_TIMEOUT_SECONDS=8
AI_CHAT_MAX_OUTPUT_TOKENS=1000
AI_RAG_ENABLED=false
AI_RAG_EMBEDDING_PROVIDER=mock
AI_RAG_EMBEDDING_API_KEY=
AI_RAG_EMBEDDING_MODEL=
AI_RAG_EMBEDDING_ENDPOINT=
AI_CHAT_RATE_LIMIT_REQUESTS=20
AI_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
AI_CHAT_RATE_LIMIT_MAX_KEYS=10000
SMS_PROVIDER=disabled
OTP_PROVIDER=disabled
EMAIL_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=
PAYMENT_API_URL=https://payment.zarinpal.com/pg/v4/payment
PASSWORD_RESET_PROVIDER=smtp
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TRACKING_RATE_LIMIT_REQUESTS=30
TRACKING_RATE_LIMIT_WINDOW_SECONDS=60
APP_PUBLIC_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMS_WEBHOOK_URL=
REDIS_URL=
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_WIDTH=4096
UPLOAD_MAX_HEIGHT=4096
CONVERSATION_RETENTION_DAYS=90

# Cloudinary settings. Supply real values outside version control.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=