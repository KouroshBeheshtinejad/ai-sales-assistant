# Set APP_ENV=production only in a managed HTTPS environment.
APP_ENV=development
DATABASE_URL=
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
APP_ALLOWED_HOSTS=

# Docker Compose database settings. Supply real values outside version control.
POSTGRES_DB=nava
POSTGRES_USER=nava
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Keep external AI providers disabled unless explicitly configured.
AI_CHAT_PROVIDER=disabled
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_CHAT_TIMEOUT_SECONDS=8
AI_RAG_ENABLED=false
AI_RAG_EMBEDDING_PROVIDER=mock
AI_RAG_EMBEDDING_API_KEY=
AI_RAG_EMBEDDING_MODEL=
AI_RAG_EMBEDDING_ENDPOINT=
AI_CHAT_RATE_LIMIT_REQUESTS=20
AI_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
AI_CHAT_RATE_LIMIT_MAX_KEYS=10000
SMS_PROVIDER=disabled

# Cloudinary settings. Supply real values outside version control.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=